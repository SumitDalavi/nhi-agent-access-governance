# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: nhi-agent-access-governance
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - Embedded OPA policy evaluator and mock agent identity registry.
#
# TIER 2 / TIER 3: PRODUCTION POSTGRESQL & REMOTE OPA SERVER
# - Supply database credentials and remote Open Policy Agent endpoint.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nhi_db
OPA_URL=http://localhost:8181/v1/data
OTLP_TRACE_URL=http://localhost:4318/v1/traces
DEMO_MODE=true
PORT=3000
